{
  // Static site for Cloudflare Pages. Project name is unchanged so an
  // existing Pages project can keep deploying this directory.
  "name": "douglassemail",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "."
  }
  // Contact mail: set CONTACT_EMAIL in the Cloudflare Pages dashboard
  // (Settings → Environment variables) for Production and Preview.
  // Do not commit the address. functions/api/contact.js reads context.env.CONTACT_EMAIL.
}
